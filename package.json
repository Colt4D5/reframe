{
  "name": "reframe",
  "version": "0.1.0",
  "description": "ReFrame is a social news platform for sharing articles, exposing framing and media bias, and rewriting stories in a sarcastic tone to spark critical discussion.",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter frontend dev",
    "build:web": "pnpm --filter frontend build",
    "check:web": "pnpm --filter frontend check",
    "lint:web": "pnpm --filter frontend lint",
    "test:web": "pnpm --filter frontend test",
    "dev:api": "cd apps/backend && go run ./cmd/server",
    "build:api": "cd apps/backend && go build -o bin/server ./cmd/server",
    "docker:up": "docker compose -f apps/docker/docker-compose.yml up --build",
    "docker:down": "docker compose -f apps/docker/docker-compose.yml down"
  },
  "keywords": [
    "news",
    "media-bias",
    "social-platform",
    "sveltekit",
    "go",
    "sarcastic-news",
    "civic-media"
  ],
  "author": "ReFrame Team",
  "license": "UNLICENSED",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.23.0",
  "type": "module"
}
